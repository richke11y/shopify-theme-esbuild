{% liquid 
	assign shop_name = shop.name
%}

{% comment %}
  This section is used in the password template to render landing page shown
  when password protection is applied to a store.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

<div class="password">

	<div class="password-form">

		<h1>{{ shop_name }}</h1>

		{% form 'storefront_password', class: 'form' %}

			{% if form.errors %}
			<div class="form__row">
				
				{{ form.errors | default_errors }}
			
			</div>
			{% endif %}

			<div class="form__row">

				<label for="bookFullName" class="form__label" for="password-input">Password *</label>

				<input class="form__input" type="password" name="password" id="password-input" required />

			</div>

			<div class="form__row">

				<button type="submit" class="submit-form button button--block button--block-grey form__submit">Submit</button>

			</div>

		{% endform %}

	</div>

</div>

{% schema %}
{
  "name": "Password",
  "class": "section",
  "settings": []
}
{% endschema %}
