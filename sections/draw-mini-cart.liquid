{% liquid
	assign cart_item_count = cart.item_count
	assign cart_total_price = cart.total_price | money_without_trailing_zeros

	echo 'draws.bundle.draw-mini-cart.css' | asset_url | stylesheet_tag
%}

<script type="module" src="{{ 'draws.bundle.draw-mini-cart.js' | asset_url }}" defer></script>

<draw-mini-cart>

	<div class="draw" data-draw-element="draw-mini-cart">

		{% render 'form-mini-cart' %}

	</div>

</draw-mini-cart>

{% schema %}
{
	"name": "Mini Cart Draw",
	"settings": [
		{
			"id": "payment_options",
			"type": "checkbox",
			"default": true,
			"label": "Enable/Disable Icons"
		}
	]
}
{% endschema %}