{% liquid
	assign item_product_id = item.product.id
	assign item_product_title = item.product.title
	assign item_product_type = item.product.type | handleize
	assign item_variant_id = item.variant_id
	
	assign item_id = item.id
	assign item_key = item.key
	assign image = item.image
	assign item_url = item.url
	assign item_line_price = item.line_price | money_without_trailing_zeros
%}

<li class="cart-items__li">

	<div class="{{ class }}" data-cart-item-index="{{ index }}" data-cart-item-id="{{ item_id }}" data-product-id="{{ item_product_id }}" data-variant-id="{{ item_variant_id }}" data-cart-key="{{ item_key }}">

		<div class="item-image">

			<a class="item-link" href="{{ item_url }}" title="{{ item_product_title }}">

				<img class="img" src="{{ image | image_url: width: 200, height: 200, crop: 'center', format: 'webp' }}" alt="{% unless image.alt == blank %}{{ image.alt }}{% else %}{{ item_product_title }}{% endunless %}" width="200" height="200" fetchpriority="low" loading="lazy" />

			</a>

		</div>

		<a class="item-link" href="{{ item_url }}" title="{{ item_product_title }}">
		
			<h4 class="item-title title">{{ item_product_title }}</h4>
		
		</a>

		<div class="item-options">
	
			{% unless item.product.has_only_default_variant %}
			<ul class="item-options__list">

				{% for option in item.options_with_values %}
				<li class="item-options__item">

					{{ option.name }}: <span class="option-value">{{ option.value }}</span>

				</li>
				{% endfor %}

			</ul>
			{% endunless %}
		
		</div>

		<p class="item-price">{{ item_line_price }}</p>

		<div class="item-delete">

			{% liquid
				render 'cart-item-quantity', index: index, item: item
				render 'cart-item-delete', index: index, item: item
			%}

		</div>

		<div class="item-error" style="display: none;"></div>

	</div>

</li>