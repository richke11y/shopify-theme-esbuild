{% liquid
	assign shop_description = shop.description | strip_html
	assign shop_locale = shop.locale
	assign shop_name = shop.name
%}

<!doctype html>

	<html class="'no-js" lang="{{ request.locale.iso_code }}">

	<head>

		<meta charset="utf-8">

		<title>{{ shop_name }}</title>

		<meta http-equiv="X-UA-Compatible" content="IE=edge">
		<meta name="viewport" content="width=device-width">
		<meta name="description" content="{{ shop_description }}">

		<meta property="og:title" content="{{ shop_name }}">
		<meta property="og:description" content="{{ shop_description }}">
		<meta property="og:url" content="{{ canonical_url }}">
		<meta property="og:locale" content="{{ shop_locale }}" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="{{ shop_name }}" />

		<link rel="canonical" href="{{ canonical_url }}">
		<link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

		<link rel="shortcut icon" type="image/png" href="{{ 'favicon.ico' | asset_img_url }}" />
		<link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}" />
		{% comment %} <link rel="icon" type="image/png" sizes="512x512" href="{{ 'favicon-512x512.png' | asset_img_url: '512x512' }}" /> {% endcomment %}
		{% comment %} <link rel="icon" type="image/png" sizes="192x192" href="{{ 'favicon-192x192.png' | asset_img_url: '192x192' }}" /> {% endcomment %}
		<link rel="apple-touch-icon" type="image/png" sizes="180x180" href="{{ 'favicon-180x180.png' | asset_img_url: '180x180' }}" />
		<link rel="icon" type="image/png" sizes="180x180" href="{{ 'favicon-180x180.png' | asset_img_url: '180x180' }}" />
		<link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-32x32.png' | asset_img_url: '32x32' }}" />
		<link rel="icon" type="image/png" sizes="16x16" href="{{ 'favicon-16x16.png' | asset_img_url: '16x16' }}" />

		<script>document.documentElement.classList.replace('no-js', 'js');</script>

		{{ content_for_header }}

		{{ 'bundle.password.css' | asset_url | stylesheet_tag }}

	</head>

	<body>

		<main class="main">

			{{ content_for_layout }}

		</main>

	</body>

</html>
